# =============================================================================
#  RE: Code Veronica X - Custom Story Total Conversion
#  .gitignore  --  NEVER commit game assets, copyrighted data, or secrets.
#
#  NOTE: git has no inline-comment syntax. A '#' only starts a comment at the
#  BEGINNING of a line. Trailing "  # ..." text becomes part of the pattern and
#  silently disables it. All comments here are on their own line.
# =============================================================================

# --- Original / copyrighted game data (NEVER commit, NEVER publish) ---------
# The user's own legally-obtained disc image and anything extracted from it.
.game_iso/
*.iso
*.bin
*.cue
*.img
*.mdf
*.nrg

# --- Extracted game data (derivative of copyrighted assets) -----------------
data/raw/
data/extracted/
# PS2 streamed video
*.pss
*.mpeg
# PS2 audio
*.adpcm
*.vag
# PS2 IPU video
*.ipu

# --- Build output (contains injected copyrighted content) -------------------
build/
dist/
*.xdelta
*.xdelta3
*.patch

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Agent / harness scratch state (not project content) --------------------
.agent/

# --- Secrets / credentials (NEVER commit) -----------------------------------
.env
.env.*
*.pem
*.key
*.p12
id_rsa
id_rsa.pub
credentials.json
token.json

# --- OS / editor cruft ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
