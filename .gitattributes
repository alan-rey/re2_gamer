# =============================================================================
#  .gitattributes  --  RE: Code Veronica X custom story project
# =============================================================================
#
# IMPORTANT POLICY
# ----------------
# We do NOT store copyrighted game assets in this repository, and we do NOT
# mirror them into Git LFS. The game ISO and everything extracted from it is
# ignored by .gitignore. See docs/07-asset-policy.md.
#
# Git LFS is available and reserved for the project's OWN large artifacts
# (e.g. research memory captures, our own rendered/compiled research output),
# never for Capcom's data.

# --- Text: force LF in repo, native on checkout for clean diffs -------------
* text=auto eol=lf

# --- Authored content: always text, always diffable -------------------------
*.md      text
*.yaml    text
*.yml     text
*.json    text
*.py      text
*.ksy     text

# --- Binary formats we may author ourselves (LFS-ready, uncomment when used) -
# *.png   filter=lfs diff=lfs merge=lfs -text
# *.dds   filter=lfs diff=lfs merge=lfs -text
# *.wav   filter=lfs diff=lfs merge=lfs -text

# --- Windows scripts: keep CRLF on checkout ---------------------------------
*.bat     text eol=crlf
*.ps1     text eol=crlf

# --- Explicitly mark forbidden binaries as binary (defense in depth) --------
*.iso     binary
*.bin     binary
